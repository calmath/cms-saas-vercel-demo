# Example environment variables for the frontend app
# Copy to .env and fill in required secrets locally. Do NOT commit .env.

# The URL to the CMS, without the path (e.g. https://instance_id.cms.optimizely.com/)
DXP_URL=https://your-instance-id.cms.optimizely.com

# The domain where the frontend will run (e.g. your-project.vercel.app)
SITE_DOMAIN=localhost:3000

# Optimizely Graph Keys (set your own values)
OPTIMIZELY_CONTENTGRAPH_SECRET=
OPTIMIZELY_CONTENTGRAPH_APP_KEY=
OPTIMIZELY_CONTENTGRAPH_SINGLE_KEY=
OPTIMIZELY_CONTENTGRAPH_GATEWAY=https://beta.cg.optimizely.com
OPTIMIZELY_GRAPH_UPDATE_DELAY=2000
OPTIMIZELY_GRAPH_QUERY_LOG=0

# Configure Next-Auth
NEXTAUTH_URL=https://$SITE_DOMAIN
# Generate a secure random secret for production
NEXTAUTH_SECRET=

# Configure Optimizely context
OPTIMIZELY_DEBUG=0
OPTIMIZELY_PUBLISH_TOKEN=

# Optimizely Data Platform Integration
OPTIMIZELY_DATAPLATFORM_ID=
OPTIMIZLEY_DATAPLATFORM_ENDPOINT=https://api.zaius.com

# Optimizely Content Intelligence / Content Recs
OPTIMIZELY_CONTENTRECS_CLIENT=
OPTIMIZELY_CONTENTRECS_DELIVERY=
OPTIMIZELY_CONTENTRECS_DELIVERY_KEY=
OPTIMIZLEY_CONTENTRECS_ENDPOINT=https://api.idio.co

# Optimizely Web Experimentation
OPTIMIZELY_WEB_EXPERIMENTATION_PROJECT=

# Available in the frontend
NEXT_PUBLIC_OPTIMIZELY_CMS_URL=$OPTIMIZELY_CMS_URL
NEXT_PUBLIC_SITE_DOMAIN=$SITE_DOMAIN
NEXT_PUBLIC_OPTIMIZELY_WEB_EXPERIMENTATION_PROJECT=$OPTIMIZELY_WEB_EXPERIMENTATION_PROJECT